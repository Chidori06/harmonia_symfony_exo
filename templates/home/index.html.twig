{% extends 'base.html.twig' %}

{% block title %}Harmonia{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="mt-4 mb-4">Retrouvez toutes nos musiques</h1>
  
        <h2 class="mt-4 mb-4">Tous les EPs :</h2>
        <div class="row">
            {% for ep in eps %}
                <div class="col mb-3">
                    <div class="card" style="width: 18rem;">
                        <img src="{{ asset(ep.cover) }}" class="card-img-top" alt="...">
                        <div class="card-body">
                            <h5 class="card-title">{{ ep.title }}</h5>
                            <h6 class="card-title">{{ ep.artist.name }}</h6>
                            <p class="card-text">{{ ep.type }}</p>
                            <p class="card-text">Nombre de pistes : {{ ep.tracks|length }}</p>
                            <p class="card-text">Date de sortie : {{ ep.releaseAt|date('d/m/Y') }}</p>
                            <a href="{{ path('app_album_item', {'id': ep.id}) }}" class="btn btn-primary">Plus de détail</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <h2 class="mt-4 mb-4">Tous les singles :</h2>
        <div class="row">
            {% for single in singles %}
                <div class="col mb-3">
                    <div class="card" style="width: 18rem;">
                        <img src="{{ asset(single.cover) }}" class="card-img-top" alt="...">
                        <div class="card-body">
                            <h5 class="card-title">{{ single.title }}</h5>
                            <h6 class="card-title">{{ single.artist.name }}</h6>
                            <p class="card-text">{{ single.type }}</p>
                            <p class="card-text">Nombre de pistes : {{ single.tracks|length }}</p>
                            <p class="card-text">Date de sortie : {{ single.releaseAt|date('d/m/Y') }}</p>
                            <a href="{{ path('app_album_item', {'id': single.id}) }}" class="btn btn-primary">Plus de détail</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <h2 class="mt-4 mb-4">Tous les albums :</h2>
        <div class="row">
            {% for album in albums %}
                <div class="col mb-3">
                    <div class="card" style="width: 18rem;">
                        <img src="{{ asset(album.cover) }}" class="card-img-top" alt="...">
