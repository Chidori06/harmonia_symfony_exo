{% extends 'base.html.twig' %}

{% block title %}Harmonia{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="mt-4 mb-4">Retrouvez toutes nos musiques</h1>
  
        <h2 class="mt-4 mb-4">Tous les EPs :</h2>
        <div class="row">
            {% for ep in eps %}
                <div class="col mb-3">
                    {% include "components/album-card.html.twig" with {album: ep} %}
                </div>
            {% endfor %}
        </div>
        <h2 class="mt-4 mb-4">Tous les singles :</h2>
        <div class="row">
            {% for single in singles %}
                <div class="col mb-3">
                    {% include "components/album-card.html.twig" with {album: single} %}
                </div>
            {% endfor %}
        </div>
        <h2 class="mt-4 mb-4">Tous les albums :</h2>
        <div class="row">
            {% for album in albums %}
                <div class="col mb-3">
                    {% include "components/album-card.html.twig" with {album: album} %}
                </div>
            {% endfor %}
        </div>

        <h2 class="mt-4 mb-4">Tous les albums sortis après les années 2000 :</h2>
        <div class="row">
            {% for album in albumAfter %}
                <div class="col mb-3">
                    {% include "components/album-card.html.twig" with {album: album} %}
                </div>
            {% endfor %}
        </div>
        <h2 class="mt-4 mb-4">Tous les albums sortis avant les années 2000 :</h2>
        <div class="row">
            {% for album in albumBefore %}
                <div class="col mb-3">
                    {% include "components/album-card.html.twig" with {album: album} %}
                </div>
            {% endfor %}
        </div>
    </div> 
{% endblock %}
