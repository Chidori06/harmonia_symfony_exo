{% extends 'base.html.twig' %}

{% block title %}Ajouter une playlist {% endblock %}


{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card border-secondary rounded-4 shadow-lg">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold mb-1">Créer une playlist</h2>
                            <p class="text-white-50 mb-0">
                                Crée ta propre playlist
                            </p>
                        </div>
                        {{ form_start(playlistForm) }}
                        <div class="mb-4">
                            {{ form_label(playlistForm.name, null, {
                            'label_attr': {
                                'class': 'form-label fw-semibold'
                            }
                        }) }}

                            {{ form_widget(playlistForm.name, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary',
                            }
                        }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(playlistForm.description, null, {
                            'label_attr': {
                                'class': 'form-label fw-semibold'
                            }
                        }) }}
                            {{ form_widget(playlistForm.description, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary',
                            }
                        }) }}
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                {{ form_widget(playlistForm.isPublic, {
                                'attr': {
                                    'class': 'form-check-input'
                                }
                            }) }}
                                {{ form_label(playlistForm.isPublic, null, {
                                'label_attr': {
                                    'class': 'form-check-label fw-semibold'
                                }
                            }) }}
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button
                                type="submit"
                                class="btn btn-success rounded-pill px-4"
                            >
                                Créer
                            </button>
                        </div>

                        {{ form_end(playlistForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
