{% extends 'base.html.twig' %}

{% block title %}Mes playlists{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="mb-4">
            <h2 class="fw-bold mb-1">
                Mes playlists
            </h2>
            <p class="text-secondary mb-0">
                {{ app.user.playlists|length }}
                playlist{{ app.user.playlists|length > 1 ? 's' : '' }}
            </p>
            <div>
                <a
                    href="{{ path('app_playlist_add', {'user': app.user.pseudonym}) }}"
                    class="btn btn-outline-dark rounded-pill px-4 mt-4"
                >
                    Créer une playlist
                </a>
            </div>
        </div>

        {% if app.user.playlists|length > 0 %}
            <div class="row g-4">
                {% for playlist in app.user.playlists %}
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                            <div class="card-header bg-dark text-white border-0 p-4">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h4 class="fw-bold mb-1">
                                            {{ playlist.name }}
                                        </h4>
                                        <p class="text-white-50 mb-0">
                                            {{ playlist.tracks|length }}
                                            chanson{{ playlist.tracks|length > 1 ? 's' : '' }}
                                        </p>

                                        <div>
                                            <a
                                                href="#"
                                                class="btn btn-outline-light rounded-pill px-4 mt-4"
                                            >
                                                Editer une playlist
                                            </a>
                                        </div>
                                    </div>

                                    {% if playlist.isPublic %}
                                        <span class="badge bg-success rounded-pill">
                                            Public
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary rounded-pill">
                                            Privée
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            {% if playlist.description %}
                                <div class="card-body pb-2">
                                    <p class="text-secondary mb-0">
                                        {{ playlist.description }}
                                    </p>
                                </div>
                            {% endif %}

                            {% if playlist.tracks|length > 0 %}
                                <div class="list-group list-group-flush">
                                    {% for track in playlist.tracks %}
                                        <a
                                            href="{{ path('app_track_item', {'id': track.id}) }}"
                                            class="list-group-item list-group-item-action border-0 px-4 py-3"
                                        >
                                            <div class="d-flex align-items-center">
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold">
                                                        {{ track.title }}
                                                    </div>
                                                    <small class="text-secondary">
                                                        {{ track.album.artist.name }}
                                                        •
                                                        {{ track.album.title }}
                                                    </small>
                                                </div>
                                                <small class="text-secondary ms-3">
                                                    {{ track.duration|date('i:s') }}
                                                </small>
                                            </div>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="card-body text-center">
                                    <p class="text-secondary mb-0">
                                        Cette playlist ne contient aucune chanson.
                                    </p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5">
                    <h4 class="fw-bold">Aucune playlist</h4>
                    <p class="text-secondary">
                        Vous n'avez encore créé aucune playlist.
                    </p>
                    <a
                        href="{{ path('app_playlist_add', {'user': app.user.pseudonym}) }}"
                        class="btn btn-success rounded-pill px-4"
                    >
                        Créer une playlist
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

