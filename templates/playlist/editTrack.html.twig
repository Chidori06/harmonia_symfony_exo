{% extends 'base.html.twig' %}

{% block title %}Modifier une playlist {% endblock %}


{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card border-secondary rounded-4 shadow-lg">
                    <div class="card border-secondary rounded-4 shadow-lg">
                        <div class="card-body p-4 p-md-5">

                            <div class="text-center mb-4">
                                <h2 class="fw-bold mb-1">
                                    Retirer ou ajouter des chansons
                                </h2>

                                <p class="text-white-50 mb-0">
                                    {{ playlist.name }}
                                </p>
                            </div>

                            {{ form_start(tracksForm) }}

                            <div class="mb-4">
                                {{ form_label(tracksForm.tracks, null, {
                            'label_attr': {
                                'class': 'form-label fw-semibold'
                            }
                        }) }}
                                <div class="mt-3">
                                    {% for track in tracksForm.tracks %}
                                        <div class="form-check mb-3 p-3 border border-secondary rounded-3">
                                            {{ form_widget(track, {
                                        'attr': {
                                            'class': 'form-check-input'
                                        }
                                    }) }}
                                            {{ form_label(track, null, {
                                        'label_attr': {
                                            'class': 'form-check-label ms-2'
                                        }
                                    }) }}
                                        </div>
                                    {% endfor %}

                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <button
                                    type="submit"
                                    class="btn btn-success rounded-pill px-4"
                                >
                                    Editer
                                </button>
                            </div>
                            {{ form_end(tracksForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
