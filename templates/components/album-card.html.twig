<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

    <div class="position-relative">
        <img
            src="{{ asset(album.cover) }}"
            class="card-img-top"
            alt="Pochette de {{ album.title }}"
        >

        {# Type de l'album : pour changer la couleur du badge #}
        {% set badgeClass = {
            'Album': 'bg-primary',
            'EP': 'bg-success',
            'Single': 'bg-warning text-dark',
            'Compilation': 'bg-info text-dark'
        }[album.type]|default('bg-secondary') %}

        <span class="badge {{ badgeClass }} rounded-pill position-absolute top-0 end-0 m-3 shadow-sm">
            {{ album.type }}
        </span>
    </div>

    <div class="card-body d-flex flex-column p-4">
        <div class="mb-3">
            <h5 class="card-title fw-bold mb-1 text-truncate">
                {{ album.title }}
            </h5>

            <p class="card-text text-secondary mb-0">
                {{ album.artist.name }}
            </p>
        </div>

        <div class="d-flex align-items-center gap-3 text-secondary small mb-4">

            <span>
                {{ album.tracks|length }} pistes
            </span>

            <span class="text-muted">•</span>

            <span>
                {{ album.releaseAt|date('d/m/Y') }}
            </span>

        </div>
        <a
            href="{{ path('app_album_item', {'id': album.id}) }}"
            class="btn btn-dark rounded-pill w-100 mt-auto"
        >
            Écouter l'album
        </a>

    </div>
</div>


