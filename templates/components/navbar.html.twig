                                    Genres
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    {% set genres = getGenres() %}
                                    <li><a class="dropdown-item" href="{{ path('app_genre') }}">Tous les genres</a></li> 
                                    {% for genre in genres %}
                                        <li><a class="dropdown-item" href="{{ path('app_genre_item', {'id': genre.id}) }}">{{ genre.label }}</a></li> 
                                    {% endfor %}
                                </ul>
                            </li>
                        </ul>
                    </div>
