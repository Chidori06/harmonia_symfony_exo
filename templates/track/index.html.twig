{% extends 'base.html.twig' %}

{% block title %}Liste des chansons{% endblock %}

{% block body %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
            <div>
                <h2 class="fw-bold mb-1">Toutes les chansons</h2>
                <p class="text-secondary mb-0">
                    {{ tracks|length }} chanson(s)
                </p>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="ps-4">#</th>
                            <th scope="col">Titre</th>
                            <th scope="col">Durée</th>
                            <th scope="col">Album</th>
                            <th scope="col">Genre(s)</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for track in tracks %}
                            <tr>
                                <th scope="row" class="ps-4 text-secondary">
                                    {#Permet d'avoir un index de 1 à ... #}
                                    {{ loop.index }}
                                </th>
                                <td>
                                    <span class="fw-semibold">
                                        {{ track.title }}
                                    </span>
                                </td>
                                <td class="text-secondary">
                                    {{ track.duration|date('h:i:s') }}
                                </td>
                                <td>
                                    <span class="text-secondary">
                                        {{ track.album.title }}
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        {% for genre in track.genres %}
                                            <a
                                                href="{{ path('app_genre_item', {'id': genre.id}) }}"
                                                class="badge rounded-pill text-decoration-none"
                                                style="background-color: {{ genre.color }}"
                                            >
                                                {{ genre.label }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <a
                                        href="{{ path('app_track_item', {'id': track.id}) }}"
                                        class="btn btn-outline-success btn-sm rounded-pill px-3"
                                    >
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}
