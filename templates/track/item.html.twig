{% extends 'base.html.twig' %}

{% block title %}Chanson : {{ track.title }}{% endblock %}


{% block body %}
    <div class="container">
        <h2 class="mt-4 mb-4">Chanson : {{ track.title }}</h2>
        <p>Numéro de piste : {{ track.numberTrack }}</p>
        <p>Durée : {{ track.duration|date('h:i:s') }}</p>
        <p>Album : {{ track.album.title }}</p>
        <p>Contenu explicite : {{ track.isExplicit ? 'Oui' : 'Non' }}</p>
        <p>Nombre d'écoutes : {{ track.playCount }}</p>
        <p>Genre(s) :</p>
        {% for genre in track.genres %}
            <p style="color:{{ genre.color }} "> {{ genre.label }}</p>
        {% endfor %}
    </div>
{% endblock %}
