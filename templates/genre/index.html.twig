{% extends 'base.html.twig' %}

{% block title %}Les genres{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Tous les genres</h2>
                <p class="text-secondary mb-0">{{ genres|length }} genres musicaux</p>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="ps-4">#</th>
                            <th scope="col">Genre</th>
                            <th scope="col">Chansons</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for genre in genres %}
                            <tr>
                                <th scope="row" class="ps-4 text-secondary">
                                    {{ loop.index }}
                                </th>
                                <td>
                                    <a
                                        href="{{ path('app_genre_item', {'id': genre.id}) }}"
                                        class="badge rounded-pill text-decoration-none"
                                        style="background-color: {{ genre.color }}"
                                    >
                                        {{ genre.label }}
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-semibold">
                                        {{ genre.tracks|length }}
                                    </span>

                                    <span class="text-secondary small">
                                        chanson{{ genre.tracks|length > 1 ? 's' : '' }}
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a
                                        href="{{ path('app_genre_item', {'id': genre.id}) }}"
                                        class="btn btn-outline-success btn-sm rounded-pill px-3"
                                    >
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
