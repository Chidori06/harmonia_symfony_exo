{% extends 'base.html.twig' %}

{% block title %}Le genre : {{ genre.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">{{ genre.label }}</h2>
                <p class="text-secondary mb-0"> Détail du genre</p>
            </div>
            <a
                href="{{ path('app_genre') }}"
                class="btn btn-outline-secondary rounded-pill"
            >
                ← Retour
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div
                class="card-header text-white border-0 p-4"
                style="background-color: {{ genre.color }}"
            >
                <div class="d-flex align-items-center gap-3">
                    <div
                        class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width: 60px; height: 60px;"
                    >
                        <span class="fs-3">♫</span>
                    </div>

                    <div>
                        <h3 class="fw-bold mb-1">{{ genre.label }}</h3>
                        <div class="text-white-50">
                            Genre musical
                        </div>
                    </div>

                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <div class="bg-light rounded-3 p-3 h-100">
                            <small class="text-secondary d-block mb-1">
                                Nom
                            </small>

                            <span class="fs-5 fw-semibold">
                                {{ genre.label }}
                            </span>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <div class="bg-light rounded-3 p-3 h-100">
                            <small class="text-secondary d-block mb-1">
                                Nombre de chansons
                            </small>

                            <span class="fs-5 fw-semibold">
                                {{ genre.tracks|length }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-header bg-dark text-white border-0 p-4">
                <h4 class="fw-bold mb-1">Chansons</h4>
                <small class="text-white-50">
                    {{ genre.tracks|length }} chansons dans ce genre
                </small>
            </div>

            <div class="list-group list-group-flush">
                {% for track in genre.tracks %}
                    <a
                        href="{{ path('app_track_item', {'id': track.id}) }}"
                        class="list-group-item list-group-item-action border-0 py-3 px-4"
                    >
                        <div class="row align-items-center">

                            <div class="col-auto">
                                <span class="text-secondary">
                                    {{ track.numberTrack }}
                                </span>
                            </div>

                            <div class="col">
                                <div class="fw-semibold">
                                    {{ track.title }}
                                </div>

                                <small class="text-secondary">
                                    {{ track.album.title }}
                                </small>
                            </div>

                            <div class="col-auto text-secondary">
                                {{ track.duration|date('i:s') }}
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="p-4 text-center text-secondary">
                        Aucune chanson associée à ce genre.
                    </div>
                {% endfor %}
            </div>

            <div class="card-footer bg-white border-0 p-4">
                <a
                    href="{{ path('app_home') }}"
                    class="btn btn-dark rounded-pill px-4"
                >
                    ← Retour à l'accueil
                </a>
            </div>
        </div>
    </div>

{% endblock %}
